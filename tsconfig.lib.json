{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist/types",
    "types": ["react", "react-dom", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src/index.ts", "src/vite-worker.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test", "demo"]
}
